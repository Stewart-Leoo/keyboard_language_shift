# ================================================================
# Visual Studio
# ================================================================

# 编译输出目录
[Dd]ebug/
[Rr]elease/
x64/
x86/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# VS 用户配置文件（本地路径、调试设置等，不应共享）
*.user
*.suo
*.userosscache
*.sln.docstates
*.vcxproj.user

# VS 缓存与临时文件
.vs/
*.aps
*.ncb
*.opendb
*.opensdf
*.sdf
*.cachefile
*.VC.db
*.VC.VC.opendb

# 预编译头
*.pch
*.gch
*.ipch

# 增量链接文件
*.ilk

# 调试数据库
*.pdb

# 静态库 / 导入库
*.lib
*.exp

# 可执行文件（编译产物，不纳入版本控制）
*.exe
*.dll

# ================================================================
# 项目运行时生成的文件
# ================================================================

# 本地键盘配置（包含用户私有设备路径，不应共享）
keyboard_config.json

# ================================================================
# 资源图标（体积较大的二进制，可按需决定是否忽略）
# 若希望共享图标文件，将下面两行注释掉
# ================================================================
# *.ico
# *.png

# ================================================================
# 系统 / 编辑器杂项
# ================================================================

# Windows 缩略图缓存
Thumbs.db
ehthumbs.db
Desktop.ini

# macOS DS_Store
.DS_Store
